<UserControl x:Class="CPRemote.Windows.FaderKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Cursor="Hand"
             AutomationProperties.Name="Main fader"
             AutomationProperties.HelpText="Drag, turn the mouse wheel or press the arrow keys to change the level">
  <Viewbox Stretch="Uniform">
    <Grid Width="100" Height="100">
      <Ellipse Width="100" Height="100" Fill="{StaticResource KnobBrush}" Stroke="Black" StrokeThickness="2">
        <Ellipse.Effect>
          <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="5" ShadowDepth="3" Direction="90" />
        </Ellipse.Effect>
      </Ellipse>
      <!-- The finger dimple: it turns with the knob. -->
      <Canvas x:Name="Spin" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
        <Canvas.RenderTransform>
          <RotateTransform x:Name="SpinTransform" Angle="0" />
        </Canvas.RenderTransform>
        <Ellipse Canvas.Left="37" Canvas.Top="13" Width="26" Height="26" Stretch="Fill"
                 Fill="{StaticResource DimpleBrush}" Stroke="#737373" StrokeThickness="1.2" />
      </Canvas>
    </Grid>
  </Viewbox>
</UserControl>
