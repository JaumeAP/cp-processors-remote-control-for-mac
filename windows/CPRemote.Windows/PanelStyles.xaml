<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colours of the front panels, taken from the macOS drawing. -->
  <SolidColorBrush x:Key="WhiteBrush" Color="White" />
  <SolidColorBrush x:Key="PrintBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="FaceBrush" Color="#BDBDBD" />
  <SolidColorBrush x:Key="DividerBrush" Color="#99000000" />
  <SolidColorBrush x:Key="FrameBrush" Color="#666666" />
  <SolidColorBrush x:Key="LampBrush" Color="#595959" />
  <SolidColorBrush x:Key="LampRedBrush" Color="#FF261A" />
  <SolidColorBrush x:Key="LightTextBrush" Color="#D9D9D9" />
  <SolidColorBrush x:Key="DimTextBrush" Color="#B3B3B3" />
  <SolidColorBrush x:Key="MidTextBrush" Color="#808080" />
  <SolidColorBrush x:Key="MacroTextBrush" Color="#999999" />

  <!-- CP650 -->
  <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#B3B3B3" Offset="0" />
    <GradientStop Color="#949494" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LouvreBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#757575" Offset="0" />
    <GradientStop Color="#BDBDBD" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RedBandBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#ED212B" Offset="0" />
    <GradientStop Color="#CC141F" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="LcdBezelBrush" Color="#6B6B6B" />
  <LinearGradientBrush x:Key="LcdBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#8FC245" Offset="0" />
    <GradientStop Color="#70A333" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="LcdTextBrush" Color="#14260D" />
  <SolidColorBrush x:Key="DisplayBrush" Color="#120000" />
  <SolidColorBrush x:Key="DisplayGhostBrush" Color="#260303" />
  <SolidColorBrush x:Key="DisplayLiveBrush" Color="#FF1F14" />
  <SolidColorBrush x:Key="CradleBrush" Color="#9E9E9E" />
  <SolidColorBrush x:Key="CradleStrokeBrush" Color="#4D4D4D" />
  <SolidColorBrush x:Key="PowerBrush" Color="#E0E0E0" />
  <SolidColorBrush x:Key="DoorBrush" Color="#A8A8A8" />
  <SolidColorBrush x:Key="DoorStrokeBrush" Color="#595959" />
  <SolidColorBrush x:Key="HeaderTextBrush" Color="#F2F2F2" />

  <!-- Keycaps and the knob, shared by the panels. -->
  <RadialGradientBrush x:Key="KeycapBrush" Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.6" RadiusY="0.6">
    <GradientStop Color="#EBEBEB" Offset="0" />
    <GradientStop Color="#A8A8A8" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="DarkKeyBrush" Center="0.4,0.3" GradientOrigin="0.4,0.3" RadiusX="1" RadiusY="1">
    <GradientStop Color="#404040" Offset="0" />
    <GradientStop Color="#080808" Offset="1" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="DarkKeyStrokeBrush" Color="#8C8C8C" />
  <RadialGradientBrush x:Key="KnobBrush" Center="0.38,0.3" GradientOrigin="0.38,0.3" RadiusX="0.65" RadiusY="0.65">
    <GradientStop Color="#5C5C5C" Offset="0" />
    <GradientStop Color="#191919" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="DimpleBrush" Center="0.4,0.35" GradientOrigin="0.4,0.35" RadiusX="0.5" RadiusY="0.5">
    <GradientStop Color="#141414" Offset="0" />
    <GradientStop Color="#474747" Offset="1" />
  </RadialGradientBrush>

  <!-- CP750 -->
  <LinearGradientBrush x:Key="Cp750FrontBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#DBDBDB" Offset="0" />
    <GradientStop Color="#999999" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ChassisBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="DolbyRedBrush" Color="#CC141A" />
  <SolidColorBrush x:Key="InputLabelBrush" Color="#4D4D4D" />
  <SolidColorBrush x:Key="UsbBrush" Color="#404040" />
  <SolidColorBrush x:Key="DeepDisplayBrush" Color="#171717" />
  <SolidColorBrush x:Key="SilverTextBrush" Color="#E5E5E5" />

  <!-- CP850 -->
  <SolidColorBrush x:Key="BlackChassisBrush" Color="#0F0F0F" />
  <LinearGradientBrush x:Key="BlackFrontBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#212121" Offset="0" />
    <GradientStop Color="#0D0D0D" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="BlueBrush" Color="#408CFF" />
  <LinearGradientBrush x:Key="InlayBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E0E0E0" Offset="0" />
    <GradientStop Color="#A8A8A8" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CalcLcdBrush" Color="#9EBDC7" />
  <SolidColorBrush x:Key="CalcTextBrush" Color="#0F1F29" />

  <!-- CP950 -->
  <SolidColorBrush x:Key="DarkChassisBrush" Color="#292929" />
  <LinearGradientBrush x:Key="DarkFrontBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#383838" Offset="0" />
    <GradientStop Color="#1F1F1F" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ScreenBrush" Color="#0D121A" />
  <SolidColorBrush x:Key="LedBrush" Color="#33CC4D" />
  <SolidColorBrush x:Key="GrilleBrush" Color="#0F0F0F" />
  <SolidColorBrush x:Key="GrilleDotBrush" Color="#666666" />

  <!-- A round key that presses: a cream keycap, lit by the Tag brush (drawn over the cap). -->
  <Style x:Key="KeycapStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource KeycapBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PrintBrush}" />
    <Setter Property="FontWeight" Value="Heavy" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Viewbox Stretch="Uniform">
            <Grid x:Name="Face" Width="100" Height="100">
              <Ellipse Width="100" Height="100" Fill="{TemplateBinding Background}" Stroke="Black" StrokeThickness="8" />
              <Ellipse Width="100" Height="100" Fill="{TemplateBinding Tag}" Opacity="0.75" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Viewbox>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A round black key with a label or a glyph; its Foreground colours the glyph. -->
  <Style x:Key="DarkKeyStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource DarkKeyBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LightTextBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Viewbox Stretch="Uniform">
            <Grid x:Name="Face" Width="100" Height="100">
              <Ellipse Width="100" Height="100" Fill="{TemplateBinding Background}" Stroke="{StaticResource DarkKeyStrokeBrush}" StrokeThickness="5" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Viewbox>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A button with no chrome: a display, a label or a glyph that acts when pressed. -->
  <Style x:Key="PlainButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
