<Window x:Class="CPRemote.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Setup" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Processor" VerticalAlignment="Center" Margin="0,0,12,10" />
    <ComboBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
              AutomationProperties.Name="Processor" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Processor IP" VerticalAlignment="Center" Margin="0,0,12,10" />
    <TextBox x:Name="AddressBox" Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,10"
             AutomationProperties.Name="Processor IP address" />

    <TextBlock x:Name="PortText" Grid.Row="3" Grid.Column="1" Foreground="Gray" Margin="0,0,0,10" />

    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
      <Button x:Name="TestButton" Content="Test" Padding="12,4" Click="TestButton_Click"
              AutomationProperties.Name="Test the processor" />
      <ProgressBar x:Name="TestProgress" Width="80" Height="6" Margin="12,0,0,0" IsIndeterminate="True"
                   Visibility="Collapsed" AutomationProperties.Name="Test in progress" />
    </StackPanel>

    <TextBlock x:Name="TestResultText" Grid.Row="5" Grid.ColumnSpan="2" MinHeight="20" TextWrapping="Wrap"
               Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite" />

    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Padding="12,4" Margin="0,0,8,0"
              AutomationProperties.Name="Cancel" />
      <Button x:Name="SaveButton" Content="Save and Connect" IsDefault="True" Padding="12,4"
              Click="SaveButton_Click" AutomationProperties.Name="Save and connect" />
    </StackPanel>
  </Grid>
</Window>
