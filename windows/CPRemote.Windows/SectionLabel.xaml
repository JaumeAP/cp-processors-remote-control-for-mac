<UserControl x:Class="CPRemote.Windows.SectionLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A name printed on the panel, with a rule through it that the name's tab breaks. -->
  <Grid>
    <Rectangle x:Name="Rule" Height="0.8" Stretch="Fill" VerticalAlignment="Center"
               Fill="{StaticResource PrintBrush}" />
    <Border Background="{StaticResource FaceBrush}" Padding="4,0"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="Caption" FontSize="9" FontWeight="SemiBold" FontStyle="Italic"
                 Foreground="{StaticResource PrintBrush}" />
    </Border>
  </Grid>
</UserControl>
